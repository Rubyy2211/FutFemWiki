{
  "version": 8,
  "name": "FIFA Dark Satellite",
  "projection": {
    "type": "globe"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=LYmhz1BKy6QniXWrxK2S"
    },
    "satellite_maptiler": {
      "type": "raster",
      "url": "https://api.maptiler.com/tiles/satellite-v2/tiles.json?key=LYmhz1BKy6QniXWrxK2S",
      "tileSize": 256
    }
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=LYmhz1BKy6QniXWrxK2S",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#07020d"
      }
    },
    {
      "id": "satellite-layer",
      "type": "raster",
      "source": "satellite_maptiler",
      "paint": {
        "raster-saturation": -0.4,
        "raster-contrast": 0.2,
        "raster-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#140026",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "countries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", "admin_level", 2],
        ["!=", "maritime", 1]
      ],
      "paint": {
        "line-color": "#920092",
        "line-width": 1.2,
        "line-opacity": 0.8
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!=", "class", "ferry"],
      "paint": {
        "line-color": "#ff33ff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.3,
          12, 1.5
        ],
        "line-opacity": 0.4
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 9,
          10, 15
        ],
        "text-font": ["Open Sans Regular"]
      },
      "paint": {
        "text-color": "#d8b4fe",
        "text-halo-color": "#07020d",
        "text-halo-width": 1.5
      }
    }
  ]
}